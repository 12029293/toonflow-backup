   return { type: "base64", data: bytes.toString("base64"), mimeType, name: reference.path };
 }
 
+// ACT: Providers such as YuxiBox H3 accept only public HTTPS links for reference
+// media and reject inline base64. When a public base URL is configured, hand out a
+// readable URL for the workspace file instead of embedding the bytes.
+export async function readRemoteReference(cwd: string, reference: MediaReference, mediaType: string, signal?: AbortSignal) {
+  signal?.throwIfAborted();
+  const base = (process.env.TOONFLOW_PUBLIC_BASE_URL ?? "").trim().replace(/\/+$/, "");
+  if (!/^https?:\/\//i.test(base)) return readReference(cwd, reference, mediaType, signal);
+  const resolved = await resolveWorkspacePath(cwd, reference.path);
+  const info = await stat(resolved.path);
+  if (!info.isFile() || info.size > maxMediaSize) invalid("Reference media must be a file no larger than 100 MB");
